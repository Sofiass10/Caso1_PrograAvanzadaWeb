  "item": [
    {
      "name": "1. GET todos los álbumes",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/Album",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "Album"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Trae 3 álbumes con el artista\", function () {",
              "    const datos = pm.response.json();",
              "    pm.expect(datos.length).to.eql(3);",
              "    pm.expect(datos[0].artista).to.not.be.empty;",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "2. GET filtrar por artista",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/Album?artista=beatles",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "Album"
          ],
          "query": [
            {
              "key": "artista",
              "value": "beatles"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Solo Abbey Road\", function () {",
              "    const datos = pm.response.json();",
              "    pm.expect(datos.length).to.eql(1);",
              "    pm.expect(datos[0].titulo).to.include(\"Abbey Road\");",
              "});"
            ]
          }
        }
      ]
    },
